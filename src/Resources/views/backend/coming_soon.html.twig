{% extends '@Contao_ContaoCoreBundle/be_main.html.twig' %}

{% block title %}{{ headline }} – Contao PDF-Import{% endblock %}

{% block main_content %}
    <div id="tl_buttons">
        <a href="{{ path('contao_backend') }}" class="header_back" title="Zurueck">Zurueck</a>
    </div>

    <h2 class="sub_headline">{{ headline }}</h2>

    <div class="tl_listing_container">
        <div class="tl_message">
            <p class="tl_info">{{ subline }}</p>
        </div>

        <div class="tl_formbody">
            <fieldset class="tl_box">
                <legend>Geplante Phasen</legend>
                <table class="tl_listing" style="width:100%">
                    <thead>
                        <tr>
                            <th class="tl_folder_tlist" style="width:60px">Schritt</th>
                            <th class="tl_folder_tlist" style="width:200px">Name</th>
                            <th class="tl_folder_tlist">Beschreibung</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for phase in phases %}
                            <tr class="{{ loop.index is odd ? 'odd' : 'even' }}">
                                <td class="tl_file_list" style="font-family:var(--font-mono, monospace); font-weight:bold">{{ phase[0] }}</td>
                                <td class="tl_file_list"><strong>{{ phase[1] }}</strong></td>
                                <td class="tl_file_list">{{ phase[2] }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </fieldset>

            <p class="tl_help" style="margin-top:1em">
                Diese Seite ist ein Stub. Die eigentliche Implementierung folgt
                gemaess der Bauphasen im Bundle-Memory
                (<code>project_dos_box_pattern.md</code>).
            </p>
        </div>
    </div>
{% endblock %}
