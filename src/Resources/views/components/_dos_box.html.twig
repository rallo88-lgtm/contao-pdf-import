{# DOS-Box-Container-Markup als Macro.
   ASCII-Header bleibt Page-spezifisch — uebergeben als header_html-Parameter
   (mit |raw gerendert weil ASCII-Linien + Inline-Spans drin sind).

   Nutzung in BE-Pages:
       {% from "@ContaoPdfImport/components/_dos_box.html.twig" import dos_box %}
       {% set header %}<pre class="dos-header">╔════╗
║ <span class="title">TITEL</span>             ║
╚════╝</pre>{% endset %}
       {{ dos_box(header) }}

   Innere JS findet die Box per [data-dos=root]; mehrere Boxen pro Page sind
   moeglich indem man jeder eine eindeutige id mitgibt. #}

{% macro dos_box(header_html, id = 'dos-box-1') %}
    <div class="dos-box" data-dos=root id="{{ id }}">
        {{ header_html|raw }}

        <div class="dos-output" data-dos=output>
            <div class="dos-line dim">→ DOS-Box ready.</div>
            <span class="dos-cursor" data-dos=cursor>&nbsp;</span>
        </div>

        <div class="dos-input-area" data-dos=input-area>
            <span class="dos-input-prompt" data-dos=input-prompt></span>
            <input type="text" data-dos=input-field autocomplete="off" spellcheck="false">
        </div>
    </div>
{% endmacro %}
