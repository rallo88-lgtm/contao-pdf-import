{% extends '@Contao_ContaoCoreBundle/be_main.html.twig' %}

{% block title %}PDF-Import – RCT Toolbox{% endblock %}

{% block main_content %}
    <link rel="stylesheet" href="/bundles/contaopdfimport/css/jobs.css">

    <div id="tl_buttons">
        <a href="{{ path('contao_backend') }}" class="header_back" title="Zurueck">Zurueck</a>
    </div>

    <h2 class="sub_headline">PDF-Import &mdash; Jobs</h2>

    {% if tableMissing %}
        <div class="tl_message">
            <p class="tl_error">
                Tabelle <code>tl_pdf_import_job</code> existiert noch nicht. Bitte
                <code>contao:migrate --no-interaction</code> ausfuehren.
            </p>
        </div>
    {% else %}
        <div class="jobs-toolbar">
            <a href="{{ path('pdf_import_new') }}" class="tl_submit">
                + Neuer Import
            </a>
            <span class="jobs-toolbar-hint">
                Phase A (Upload + Split + Issue-Detection) ist live.
            </span>

            <form method="POST" action="{{ path('pdf_import_op_reset') }}" data-turbo="false" style="margin-left:auto">
                <input type="hidden" name="REQUEST_TOKEN" value="{{ request_token }}">
                <button type="submit" class="tl_submit" title="OpCache zuruecksetzen — nach Bundle-Code-Updates noetig auf Mittwald (FPM cached Bytecode)">
                    🔄 OpCache reset
                </button>
            </form>
        </div>

        {% if app.request.query.get('opcache') %}
            <div class="tl_message">
                <p class="tl_confirm">OpCache: <code>{{ app.request.query.get('opcache') }}</code></p>
            </div>
        {% endif %}

        {% if jobs is empty %}
            <div class="jobs-empty">
                <p>Noch keine Imports gestartet.</p>
                <p class="jobs-empty-sub">
                    Sobald der erste PDF-Import laeuft (C2), erscheint hier eine Liste mit Status,
                    erkannter Ausgabe und Resume-Action pro Job.
                </p>
            </div>
        {% else %}
            <table class="jobs-table">
                <thead>
                    <tr>
                        <th style="width:40px">#</th>
                        <th style="width:140px">Erstellt</th>
                        <th>PDF</th>
                        <th style="width:60px">Pages</th>
                        <th style="width:160px">Erkannte Ausgabe</th>
                        <th style="width:140px">Status</th>
                        <th style="width:120px">Letzte Phase</th>
                        <th style="width:140px">Aktionen</th>
                    </tr>
                </thead>
                <tbody>
                    {% for job in jobs %}
                        <tr>
                            <td>{{ job.id }}</td>
                            <td>{{ job.createdAt|date('Y-m-d H:i:s') }}</td>
                            <td>
                                <code>{{ job.pdfName }}</code>
                                <span class="jobs-hash">sha1:{{ job.pdfHash|slice(0, 8) }}…</span>
                            </td>
                            <td>{{ job.pageCount }}</td>
                            <td>
                                {% if job.detectedIssueNumber %}
                                    <code class="jobs-issue">MBJ-{{ job.detectedIssueNumber }}</code>
                                    {% if job.detectedIssueDate %}
                                        <span class="jobs-issue-date">{{ job.detectedIssueDate }}</span>
                                    {% endif %}
                                {% else %}
                                    <span class="jobs-empty-cell">–</span>
                                {% endif %}
                            </td>
                            <td>
                                <span class="jobs-status-badge" style="background:{{ job.status.color }}">
                                    {{ job.status.label }}
                                </span>
                            </td>
                            <td>
                                {% if job.lastPhase %}
                                    <code>{{ job.lastPhase }}</code>
                                {% else %}
                                    <span class="jobs-empty-cell">–</span>
                                {% endif %}
                            </td>
                            <td>
                                <a href="{{ path('pdf_import_job', {'id': job.id}) }}" class="jobs-action">Details</a>
                                {% set resumeRoute = job.status.resumeRoute %}
                                {% if resumeRoute %}
                                    <a href="{{ path(resumeRoute, {'id': job.id}) }}" class="jobs-action">Resume</a>
                                {% else %}
                                    <a href="#" class="jobs-action is-disabled" title="Status {{ job.status.label }} — kein Resume moeglich">Resume</a>
                                {% endif %}
                                <form method="POST" action="{{ path('pdf_import_job_delete') }}" data-turbo="false" style="display:inline" onsubmit="return confirm('Job #{{ job.id }} loeschen?\n\nSoft-Delete: Row bleibt fuer Statistik erhalten, verschwindet nur aus dieser Liste.')">
                                    <input type="hidden" name="REQUEST_TOKEN" value="{{ request_token }}">
                                    <input type="hidden" name="id" value="{{ job.id }}">
                                    <button type="submit" class="jobs-action jobs-action--danger" title="Soft-Delete (Statistik bleibt)">Loeschen</button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    {% endif %}
{% endblock %}
