{% extends '@Contao_ContaoCoreBundle/be_main.html.twig' %}

{% block title %}Job #{{ job.id }} – PDF-Import{% endblock %}

{% block main_content %}
    <link rel="stylesheet" href="/bundles/contaopdfimport/css/jobs.css">

    <div id="tl_buttons">
        <a href="{{ path('pdf_import') }}" class="header_back" title="Zurueck zu Job-Listing">Zurueck</a>
    </div>

    <h2 class="sub_headline">Job #{{ job.id }} — {{ job.pdfName }}</h2>

    <div class="tl_message">
        <p class="tl_info">
            <strong>Status:</strong>
            <span class="jobs-status-badge" style="background:{{ job.status.color }}">{{ job.status.label }}</span>
            {% if job.lastPhase %} &middot; letzte Phase: <code>{{ job.lastPhase }}</code>{% endif %}
            &middot; erstellt {{ job.createdAt|date('Y-m-d H:i:s') }}
            &middot; aktualisiert {{ job.tstamp|date('Y-m-d H:i:s') }}
        </p>
    </div>

    <table class="jobs-table" style="margin-top:16px">
        <tbody>
            <tr>
                <th style="width:200px">PDF</th>
                <td>
                    <code>{{ job.pdfName }}</code>
                    <span class="jobs-hash">sha1:{{ job.pdfHash }}</span>
                </td>
            </tr>
            <tr>
                <th>Page-Count</th>
                <td>{{ job.pageCount }} Seiten</td>
            </tr>
            <tr>
                <th>Target-Archive</th>
                <td>
                    {% if job.targetArchivePid %}
                        <code>tl_news_archive id={{ job.targetArchivePid }}</code>
                    {% else %}
                        <span class="jobs-empty-cell">–</span>
                    {% endif %}
                </td>
            </tr>
            <tr>
                <th>Erkannte Ausgabe</th>
                <td>
                    {% if job.detectedIssueNumber %}
                        <code class="jobs-issue">MBJ-{{ job.detectedIssueNumber }}</code>
                        {% if job.detectedIssueDate %}
                            <span class="jobs-issue-date">{{ job.detectedIssueDate }}</span>
                        {% endif %}
                    {% else %}
                        <span class="jobs-empty-cell">– (Detection fehlgeschlagen)</span>
                    {% endif %}
                </td>
            </tr>
            <tr>
                <th>Naechste Phase</th>
                <td>
                    {% if job.status.value == 'split_done' %}
                        <a href="{{ path('pdf_import_phase_b', {'id': job.id}) }}" class="tl_submit">
                            Phase B starten · Page-Auswahl &rarr;
                        </a>
                    {% elseif job.status.value == 'pages_selected' %}
                        <a href="{{ path('pdf_import_phase_c', {'id': job.id}) }}" class="tl_submit">
                            Phase C starten · Textract-Loop &rarr;
                        </a>
                        <a href="{{ path('pdf_import_phase_b', {'id': job.id}) }}" class="jobs-action" style="margin-left:6px">
                            &larr; Phase B (Auswahl ändern)
                        </a>
                    {% elseif job.status.value == 'ocr_done' %}
                        <a href="{{ path('pdf_import_phase_d', {'id': job.id}) }}" class="tl_submit">
                            Phase D starten · Conflict-Check &rarr;
                        </a>
                        <a href="{{ path('pdf_import_phase_c', {'id': job.id}) }}" class="jobs-action" style="margin-left:6px">
                            &larr; Phase C (Re-Run)
                        </a>
                    {% elseif job.status.value == 'conflicts_resolved' %}
                        <a href="{{ path('pdf_import_phase_e', {'id': job.id}) }}" class="tl_submit">
                            Phase E starten · Real Insert &rarr;
                        </a>
                        <a href="{{ path('pdf_import_phase_d', {'id': job.id}) }}" class="jobs-action" style="margin-left:6px">
                            &larr; Phase D (Entscheidungen ändern)
                        </a>
                    {% elseif job.status.value == 'completed' %}
                        <span style="color:#10b981; font-weight:600">&check; abgeschlossen</span>
                        <a href="{{ path('pdf_import_phase_e', {'id': job.id}) }}" class="jobs-action" style="margin-left:10px">Phase E (Re-Run)</a>
                    {% elseif job.status.value == 'failed' %}
                        <span style="color:#ef4444; font-weight:600">&times; fehlgeschlagen</span>
                        <a href="{{ path('pdf_import_phase_e', {'id': job.id}) }}" class="tl_submit" style="margin-left:10px">Re-Run</a>
                    {% else %}
                        <span class="jobs-empty-cell">–</span>
                    {% endif %}
                </td>
            </tr>
        </tbody>
    </table>

    {% if payloadJson %}
        <h3 style="margin-top:24px">Payload (JSON)</h3>
        <pre style="background:var(--form-bg, #fff); border:1px solid var(--border, #ccc); padding:12px; font-size:11px; overflow-x:auto">{{ payloadJson }}</pre>
    {% endif %}
{% endblock %}
